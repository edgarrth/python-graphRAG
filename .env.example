# Neo4j
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=axiz-graphrag-poc
NEO4J_DATABASE=neo4j

SYNTHETIC_PAYMENT_COUNT=320  # adicional a los 24 pagos de ejemplo

# Retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_INDEX_NAME=knowledge_embedding
FULLTEXT_INDEX_NAME=knowledge_fulltext
DEFAULT_TOP_K=4
MAX_TOP_K=10
HYBRID_RANKER=linear
HYBRID_ALPHA=0.35
EFFECTIVE_SEARCH_RATIO=3

GRAPHSAGE_GRAPH_NAME=payments_graphsage
GRAPHSAGE_MODEL_NAME=payments_graphsage_v1

# Generation. "deterministic" works without credentials.
GENERATION_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Frontend
API_BASE_URL=http://api:8000
